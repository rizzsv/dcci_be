generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handledReports Report[]       @relation("HandledReports")
  notifications  Notification[]
  logs           TransactionLog[]
}

model Report {
  id          String       @id @default(uuid())
  title       String
  type        DisasterType
  description String
  location    String
  latitude    Float?
  longitude   Float?
  photoUrl    String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  handledById String?
  handledBy   User? @relation("HandledReports", fields: [handledById], references: [id])

  disaster    Disaster?
}

model Disaster {
  id         String         @id @default(uuid())
  reportId   String         @unique
  type       DisasterType
  latitude   Float
  longitude  Float
  magnitude  Float?
  status     DisasterStatus @default(ACTIVE)
  source     DisasterSource @default(CITIZEN_REPORT)
  createdAt  DateTime       @default(now())
  resolvedAt DateTime?

  report Report @relation(fields: [reportId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model TransactionLog {
  id        String   @id @default(uuid())
  entity    String
  entityId  String
  action    String
  userId    String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  VOLUNTEER
}

enum ReportStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DisasterStatus {
  ACTIVE
  RESOLVED
}

enum DisasterType {
  GEMPA
  BANJIR
  TANAH_LONGSOR
  KEBAKARAN
}

enum DisasterSource {
  BMKG
  CITIZEN_REPORT
  ADMIN
}
